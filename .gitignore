# Quartz build output
public/

# Quartz framework (gegenereerd door postinstall)
/quartz

# Dependencies
node_modules/

# IDE
.idea/
.vscode/

# OS
.DS_Store

# Claude Code local state (worktrees, session data, etc.)
.claude/

# Resources — bulk raw downloads (PDFs, txt, xlsx, ...)
# Alleen de bulk-mappen worden geignoreerd; hand-curated raw inputs
# (voorbeeldexamens, andere/) blijven tracked omdat ze niet auto-fetchable zijn.
resources/raw/wetteksten/
resources/raw/normen/

**/__pycache__/
*.pyc

# PO-build voortgang (lokaal, niet in repo)
.po-voortgang-*.md

# RAG data (gegenereerd, herbouwbaar)
data/rag/main/
data/rag/1.1/
data/rag/4.0/

# QA-rapporten (gegenereerd door tools/etl/qa_bron.py — per-run, niet getracked)
data/etl/qa/

# Concept-records: levende kennislaag, gegit zodat git-history fungeert als
# enrichment-versionering + auto_merge.py (ADR-008 §13.4) een referentiepunt heeft.
# Archief blijft gitignored (alleen lokale traceability).
data/concepten/_archive/
data/cases/
data/relations.json

# Extractie-output: rapporten, instructies, anchors en bundles worden gegit;
# run-specifieke payload-copies (verify-runs en enrich-runs bundles) niet —
# die zijn reproduceerbaar uit anchors + record-state.
data/extractie/*/verify-runs/records-*.json
data/extractie/*/verify-runs/anchors-*.json
data/extractie/*/verify-runs/examen_vragen-*.json
data/extractie/*/enrich-runs/bundle-*.json

# Python virtual envs
venv/
.venv/

# Environment variables
.env

# Review-artifacts (gegenereerd door review-agents)
.factcheck-*.md
.leesbaarheid-*.md
.student-feedback*.md
data/extractie/matches/
