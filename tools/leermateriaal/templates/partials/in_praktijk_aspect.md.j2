{% for blok in in_praktijk %}
{% if blok is string %}
- {{ blok }}
{% else %}
<h3 id="{{ blok.anker_slug | default(blok.aspect | lower | replace(' ', '-')) }}">{{ blok.aspect }}</h3>

> [!tip]- {{ blok.aspect }}
> {{ blok.betekenis }} {{ blok.confidence | default('inferred') | confidence_label }}
{% if blok.wereld_voorbeeld %}
>
> **Voorbeeld**: {{ blok.wereld_voorbeeld }}
{% endif %}

{% if blok.herkenningspunt %}
> [!tip]- Herkennen op het examen
> {{ blok.herkenningspunt }}

{% endif %}
{% endif %}
{% endfor %}
