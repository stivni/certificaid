{% for bouwsteen in bouwstenen %}
{% if bouwsteen is mapping %}
{% set raw_titel = bouwsteen.titel if bouwsteen.titel else (bouwsteen.text[:80] if bouwsteen.text else '') %}
{% set titel_schoon = raw_titel | regex_replace('\\s*\\(KB WVV.*?\\)\\s*$', '') | regex_replace('\\s*\\(WVV.*?\\)\\s*$', '') %}
{% set titel_suffix = raw_titel | regex_search('(KB WVV[^)]+|WVV[^)]+)') %}
### {{ titel_schoon }} {{ bouwsteen.confidence | default('inferred') | confidence_label }}

{% if bouwsteen.wat %}
{{ bouwsteen.wat }}
{% elif bouwsteen.text %}
{{ bouwsteen.text }}
{% endif %}

{% if bouwsteen.waarom %}
**Waarom?** {{ bouwsteen.waarom }}
{% endif %}

{% if bouwsteen.voorbeeld_inline %}
**Voorbeeld**: {{ bouwsteen.voorbeeld_inline }}
{% endif %}

{% if bouwsteen.in_praktijk is string %}
**In de praktijk**: {{ bouwsteen.in_praktijk }}
{% elif bouwsteen.in_praktijk is iterable and bouwsteen.in_praktijk %}
**In de praktijk**:
{% for item in bouwsteen.in_praktijk %}
{% if item is mapping %}
- **{{ item.aspect | default('') }}**: {{ item.betekenis | default('') }}{% if item.confidence is defined %} {{ item.confidence | confidence_label }}{% endif %}

{% else %}
- {{ item }}
{% endif %}
{% endfor %}
{% endif %}

{% if bouwsteen.voorbeelden %}
{% set voorbeelden = bouwsteen.voorbeelden %}
{% include 'partials/voorbeelden.md.j2' %}
{% endif %}
{% if bouwsteen.illustraties %}
{% set illustraties = bouwsteen.illustraties %}
{% include 'partials/illustraties.md.j2' %}
{% endif %}

{% if bouwsteen.grondslag %}
_Grondslag: {{ bouwsteen.grondslag }}_
{% elif titel_suffix %}
_Grondslag: {{ titel_suffix }}_
{% endif %}

{% else %}
### {{ bouwsteen[:80] if bouwsteen is string else '' }} 🤖

{{ bouwsteen }}

{% endif %}
{% endfor %}
