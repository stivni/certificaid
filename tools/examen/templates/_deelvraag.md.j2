{# Template voor één deelvraag — natuurlijke flow zonder labels of nummering.
   De vraagstelling staat verbatim als paragraaf; het is duidelijk dat een vraag een vraag is.
   Aanpasbare secties zijn gemarkeerd met "PRUTS:" commentaar.

   Variabelen:
     volledigheid           — string ("volledig" | "topic_only" | ...)
     vraagtype              — string ("open" | "mc_keuze" | "juist_fout")
     vraagstelling          — string|None (leeg of None → niet gerenderd)
     opties                 — list[{id, tekst}]|None (alleen bij mc_keuze)
     topic_only_onderwerp   — string|None (alleen bij topic_only)
     antwoord_callout_md    — pre-rendered collapsed success-callout string
#}
{# PRUTS: Vraagstelling-formatting — huidig: gewone paragraaf zonder label.
   Alternatieven: blockquote (prefix "> "), bold, cursief #}
{% if volledigheid != "topic_only" and vraagstelling %}
{{ vraagstelling }}

{% endif %}
{# PRUTS: MC-opties — huidig: "**a)** {tekst}" als bullet-lijst.
   Alternatieven: genummerd, inline, andere brackets #}
{% if vraagtype == "mc_keuze" and opties %}
{% for optie in opties %}
- **{{ optie.id }}** {{ optie.tekst }}
{% endfor %}

{% endif %}
{# Topic-only: alleen onderwerp tonen als italic placeholder. Geen warning-
   callout — de outer topic-callout (zie _render_vraag_eenheid) signaleert
   al dat de vraag onvolledig is. #}
{% if volledigheid == "topic_only" and topic_only_onderwerp %}
_{{ topic_only_onderwerp }}_

{% endif %}
{# Antwoord-callout per deelvraag (collapsed): inhoud is in Python pre-rendered. #}
{{ antwoord_callout_md }}
